    <string name="home_start_hint">Запустите сессию, чтобы передавать цвета периметра экрана на ленту. Android запросит разрешение на захват.</string>
    <string name="home_no_device">Контроллер не выбран. Добавьте его, чтобы передавать цвета.</string>
