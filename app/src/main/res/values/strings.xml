    <string name="settings_version">Version %1$s (%2$d)</string>
    <string name="settings_build">Build type: %1$s</string>
    <string name="settings_protocols">Protocols</string>
    <string name="settings_protocols_body">DDP uses UDP 4048. WLED UDP realtime defaults to 21324 and supports WARLS, DRGB and DNRGB. UDP delivery is not guaranteed; use a stable 2.4/5 GHz network.</string>
    <string name="settings_limitations">Known limitations</string>
    <string name="settings_limitations_body">Protected (DRM) video may be black. mDNS can be blocked by guest Wi-Fi or VLANs. Very large layouts are limited to 1500 LEDs. Hyperion and USB Adalight are not included in this version.</string>
    <string name="settings_docs">Project documentation</string>
    <string name="settings_docs_body">README, architecture, protocol notes and the testing checklist are in the repository.</string>

