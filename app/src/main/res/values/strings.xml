    <!-- Onboarding -->
    <string name="onboarding_title">Light that follows your screen</string>
    <string name="onboarding_subtitle">Turn a WLED strip into a low-latency ambilight for Android TV, tablets and phones.</string>
    <string name="onboarding_point_1">Finds WLED controllers on your local network or accepts a manual address.</string>
    <string name="onboarding_point_2">Analyses the screen perimeter and sends colours over DDP or WLED UDP.</string>
    <string name="onboarding_point_3">Works with a remote on Android TV and with touch on phones.</string>
    <string name="onboarding_point_4">No account, no cloud, no analytics.</string>
    <string name="onboarding_permission_title">Screen capture is explicit</string>
    <string name="onboarding_permission_body">Android asks for consent every time a session starts. While it runs, a foreground notification with a Stop action is always visible. The app never captures without that system dialog.</string>
    <string name="onboarding_drm_title">Protected video may stay black</string>
    <string name="onboarding_drm_body">DRM-protected apps can hide their surface from screen capture. If the captured image is black, that is an Android/DRM restriction, not a WLED fault. This app does not bypass it; for guaranteed ambilight on protected content an external HDMI capture device may be required.</string>
    <string name="onboarding_setup_title">Add your controller</string>
    <string name="onboarding_setup_body">You can search with mDNS, scan the local network or type an IP address. Without a controller you can still explore calibration and diagnostics.</string>
    <string name="onboarding_open_devices">Set up a device</string>
    <string name="onboarding_step">Step %1$d of %2$d</string>

