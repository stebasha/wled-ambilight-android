    <string name="settings_privacy_body">Settings and controller addresses are stored only on this device. Screen frames are analysed in memory and never uploaded. No analytics or accounts are used.</string>
    <string name="settings_licenses">Open-source licences</string>
    <string name="settings_diagnostics_note">Diagnostics reports contain controller addresses and error codes, but never screen content, tokens or Wi-Fi credentials.</string>
